`timescale 1 ps/ 1 ps
module top_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clock;
reg clock2;
reg clock13;
reg key0;
reg key2;
reg key3;
reg rst_n;
reg rst_n8;
// wires                                               
wire buzzer;
wire [4:3] dig;
wire [6:0] seg;

// assign statements (if any)                          
top i1 (
// port map - connection between master ports and signals/registers   
	.buzzer(buzzer),
	.clock(clock),
	.clock2(clock2),
	.clock13(clock13),
	.dig(dig),
	.key0(key0),
	.key2(key2),
	.key3(key3),
	.rst_n(rst_n),
	.rst_n8(rst_n8),
	.seg(seg)
);
initial 
begin 
#1000000 $finish;
end 

// rst_n
initial
begin
	rst_n = 1'b0;
	rst_n = #20000 1'b1;
end 

// clock
always
begin
	clock = 1'b0;
	clock = #5000 1'b1;
	#5000;
end 
endmodule


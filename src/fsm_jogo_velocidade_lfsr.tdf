SUBDESIGN fsm_jogo_velocidade_lfsr
(
    clk : INPUT;
    S   : INPUT;
    F   : INPUT;
    J1  : INPUT;
    J2  : INPUT;

    L   : OUTPUT;
    E   : OUTPUT;
    B   : OUTPUT;
    I1  : OUTPUT;
    I2  : OUTPUT;
)
VARIABLE
    ff2, ff1, ff0      : DFF;
    q2, q1, q0         : NODE;
    q2_n, q1_n, q0_n   : NODE;
    J1_n               : NODE;
    empate_n           : NODE;
BEGIN
    ff2.clk = clk;
    ff1.clk = clk;
    ff0.clk = clk;

    q2   = ff2.q;
    q1   = ff1.q;
    q0   = ff0.q;
    q2_n = !ff2.q;
    q1_n = !ff1.q;
    q0_n = !ff0.q;

    J1_n     = !J1;
    empate_n = !(J1 $ J2);

    ff2.d = q2_n & q1 & q0 & (J1 $ J2);
    ff1.d = q2_n & ((q1_n & q0) # (q1 & q0_n) # (q1 & q0 & empate_n));
    ff0.d = q2_n & ((q1_n & q0_n & S) # (q1 & q0_n & F) # (q1 & q0 & (J1_n # J2)));

    L  = q2_n & q1_n & q0;
    E  = q2_n & q1   & q0_n;
    B  = q2_n & q1   & q0;
    I1 = q2   & q1_n & q0_n;
    I2 = q2   & q1_n & q0;
END;